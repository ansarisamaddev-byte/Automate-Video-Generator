  {
    "id": 2,
    "script_title": "Why You Procrastinate on Things You Want",
    "total_segments": 11,
    "posted": false,
    "timeline": [
      {
        "segment_id": 1,
        "folder": "16_podcaster_hoody",
        "text": "Procrastination is almost never about laziness—it is an emotional regulation problem."
      },
      {
        "segment_id": 2,
        "folder": "04_anxiety_overwhelm",
        "text": "When you avoid starting a project, your brain isn't rejecting the work; it’s rejecting the fear of failure attached to it."
      },
      {
        "segment_id": 3,
        "folder": "01_brain_anatomy",
        "text": "Your amygdala perceives creative uncertainty as an immediate physical threat,"
      },
      {
        "segment_id": 4,
        "folder": "13_addiction_dopamine",
        "text": "hijacking your logical prefrontal cortex and driving you toward cheap dopamine like social media."
      },
      {
        "segment_id": 5,
        "folder": "16_podcaster_hoody",
        "text": "This creates an instant relief loop that tricks your brain into thinking avoidance is safety."
      },
      {
        "segment_id": 6,
        "folder": "05_internal_conflict",
        "text": "Every time you walk away, the task feels larger, heavier, and more impossible."
      },
      {
        "segment_id": 7,
        "folder": "08_time_mechanisms",
        "text": "The antidote is lowering the activation energy using the two-minute rule."
      },
      {
        "segment_id": 8,
        "folder": "16_podcaster_hoody",
        "text": "Commit to working on it for just one hundred and twenty seconds—no expectations, no perfection."
      },
      {
        "segment_id": 9,
        "folder": "02_neural_networks",
        "text": "Once momentum kicks in, neurological friction drops and focus takes over automatically."
      },
      {
        "segment_id": 10,
        "folder": "11_building_action",
        "text": "Stop waiting for motivation. Action creates clarity; waiting creates paralysis."
      },
      {
        "segment_id": 11,
        "folder": "16_podcaster_hoody",
        "text": "Save this video for the next time you feel stuck."
      }
    ]
  },
  {
    "id": 3,
    "script_title": "The Spotlight Effect Trap",
    "total_segments": 10,
    "posted": false,
    "timeline": [
      {
        "segment_id": 1,
        "folder": "16_podcaster_hoody",
        "text": "You are judging yourself ten times harsher than anyone else in the room ever will."
      },
      {
        "segment_id": 2,
        "folder": "06_social_crowds",
        "text": "Social psychologists call this the Spotlight Effect—a cognitive bias where you overestimate how much people notice your appearance or mistakes."
      },
      {
        "segment_id": 3,
        "folder": "14_memory_and_past",
        "text": "You remember every awkward word you spoke today, assuming others are replaying it too."
      },
      {
        "segment_id": 4,
        "folder": "16_podcaster_hoody",
        "text": "In reality? Everyone around you is trapped in their own spotlight, worrying about how they come across to you."
      },
      {
        "segment_id": 5,
        "folder": "03_isolation_shadows",
        "text": "Your brain treats social judgment like a survival threat, making minor blunders feel catastrophic."
      },
      {
        "segment_id": 6,
        "folder": "07_masks_identity",
        "text": "When you realize you are barely a background extra in someone else’s movie, the weight disappears."
      },
      {
        "segment_id": 7,
        "folder": "16_podcaster_hoody",
        "text": "People aren't watching your every move. They're too busy managing their own insecurities."
      },
      {
        "segment_id": 8,
        "folder": "10_clarity_light",
        "text": "The moment you stop seeking external validation, social anxiety loses its power."
      },
      {
        "segment_id": 9,
        "folder": "15_ego_and_power",
        "text": "Step into the room like you don't need anyone's approval, and watch the dynamic shift."
      },
      {
        "segment_id": 10,
        "folder": "16_podcaster_hoody",
        "text": "Share this with someone who overthinks every social situation."
      }
    ]
  },
  {
    "id": 4,
    "script_title": "Dark Psychology of the Decoy Effect",
    "total_segments": 10,
    "posted": false,
    "timeline": [
      {
        "segment_id": 1,
        "folder": "16_podcaster_hoody",
        "text": "Companies use an asymmetric choice model to manipulate your brain into spending more money."
      },
      {
        "segment_id": 2,
        "folder": "09_traps_and_mazes",
        "text": "It’s called the Decoy Effect, and it triggers an automatic flaw in human value judgment."
      },
      {
        "segment_id": 3,
        "folder": "08_time_mechanisms",
        "text": "When offered a small option for three dollars and a large for seven, most people choose the small."
      },
      {
        "segment_id": 4,
        "folder": "16_podcaster_hoody",
        "text": "So marketers introduce a medium option for six dollars and fifty cents—a decoy designed solely to make the large look like a steal."
      },
      {
        "segment_id": 5,
        "folder": "01_brain_anatomy",
        "text": "Your brain hates evaluating items in isolation, so it looks for shortcut comparisons."
      },
      {
        "segment_id": 6,
        "folder": "02_neural_networks",
        "text": "The decoy creates a cognitive illusion of high value, overriding rational calculation."
      },
      {
        "segment_id": 7,
        "folder": "16_podcaster_hoody",
        "text": "You think you made a smart financial decision, but you were engineered to spend seven dollars all along."
      },
      {
        "segment_id": 8,
        "folder": "12_dark_textures",
        "text": "This exact psychological vulnerability is exploited in subscriptions, pricing tiers, and political campaigns."
      },
      {
        "segment_id": 9,
        "folder": "10_clarity_light",
        "text": "Recognizing the third option breaks the illusion immediately."
      },
      {
        "segment_id": 10,
        "folder": "16_podcaster_hoody",
        "text": "Save this to protect yourself from cognitive marketing traps."
      }
    ]
  },
  {
    "id": 5,
    "script_title": "The Power of the Zeigarnik Effect",
    "total_segments": 10,
    "posted": false,
    "timeline": [
      {
        "segment_id": 1,
        "folder": "16_podcaster_hoody",
        "text": "Your brain is physically incapable of forgetting unfinished tasks."
      },
      {
        "segment_id": 2,
        "folder": "14_memory_and_past",
        "text": "Discovered by Soviet psychologist Bluma Zeigarnik, this principle shows that incomplete actions create continuous mental tension."
      },
      {
        "segment_id": 3,
        "folder": "04_anxiety_overwhelm",
        "text": "When you leave a goal open, your mind keeps loop sequences open in working memory, draining cognitive energy."
      },
      {
        "segment_id": 4,
        "folder": "16_podcaster_hoody",
        "text": "This is why cliffhangers in television shows keep you hooked, and unwritten emails keep you up at night."
      },
      {
        "segment_id": 5,
        "folder": "09_traps_and_mazes",
        "text": "Your brain treats an open loop as an unresolved problem that requires constant focus."
      },
      {
        "segment_id": 6,
        "folder": "16_podcaster_hoody",
        "text": "You can use this hack to overcome extreme procrastination."
      },
      {
        "segment_id": 7,
        "folder": "11_building_action",
        "text": "Start a daunting task for just five minutes and stop mid-sentence or mid-action."
      },
      {
        "segment_id": 8,
        "folder": "08_time_mechanisms",
        "text": "The Zeigarnik Effect will force an uncomfortable urge in your mind to return and finish it."
      },
      {
        "segment_id": 9,
        "folder": "10_clarity_light",
        "text": "Force the open loop, and let your psychology handle the rest."
      },
      {
        "segment_id": 10,
        "folder": "16_podcaster_hoody",
        "text": "Save this video to hack your focus whenever you need to lock in."
      }
    ]
  }
